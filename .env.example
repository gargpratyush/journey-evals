# Use one Jev key name. journey-evals maps JEV_API_KEY in process; do not configure conflicting values.
JEV_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Agent evaluations use the same evaluator configuration by default. The key is removed from the
# environment while the target graph is imported and executed.

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side and are never
# passed to browser child processes. Every *_API_KEY, *_KEY, *_TOKEN and *_SECRET value in the
# environment is redacted from artifacts before they are written.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional. Azure's v1 surface wants max_completion_tokens and reasoning_effort rather than
# max_tokens and a reasoning object. Detected from the endpoint when unset; set it explicitly to
# override. Accepts openai or azure.
# TEXT_MODEL_DIALECT=azure

# Journey-specific values to redact are declared in the journey's own "redact" list, not here,
# so they travel with the journey rather than with the machine.
